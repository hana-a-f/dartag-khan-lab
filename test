#make hapotype file:
-f: mininum allele frequency
-m: maternal parent index, if there are several separated by comma. First sample index is 1.
-p: paternal parent index, if there are several separated by comma. First sample is 1.
-j: maternal parent name, if not set, use the first marternal individual name.
-k: paternal parent name, if not set, use the first paternal individual name.

../amplicon/to_lep_map.pl -g hap_genotype_names -f 0.001 -m 2 -p 1 -j 'Honeycrisp_m' -k 'Gala_f' -marker2pos -n HC_Gala_haplotype


##lepmap3

java -cp /programs/Lep-MAP3/bin/ ParentCall2 data = HC_Gala_haplotype.lepmap3.pedigree.txt vcfFile = HC_Gala_haplo_filtered_imputed.vcf > post.call

#Number of called markers = 1814 (1670 informative)

java -cp /programs/Lep-MAP3/bin/ Filtering2 data = post.call removeNonInformative=1 dataTolerance=0.0001 > filtpost.call
java -cp /programs/Lep-MAP3/bin/ OrderMarkers2 data=filtpost.call sexAveraged=1 map=map.txt > order.txt

awk -vfullData=1 -f map2genotypes.awk order.txt > genotypes.txt
awk '(NR>=7)' filtpost.call|cut -f 1,2 > snpnames.txt
paste snpnames.txt map.txt > snplgs.txt

#####marker to pos####

grep "^>" primer.fa | sed 's/^>//' | awk -F'_' 'BEGIN{OFS="\t"} {print $0, $(NF-1), $NF}' > marker2pos


